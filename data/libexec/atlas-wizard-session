#!/bin/sh
# The setup session (plasmalogin autologin, atlas-wizard.desktop): KWin alone
# with the wizard as its only client. Counts starts that did not end well this
# boot; at 3 it asks the helper to give up (the text-mode fallback takes over). If
# that fails it logs, waits and exits non-zero; on SetupDone it calls EndSetup.

dir=/run/atlas-setup
counter=$dir/session-failures

failures=0
if [ -r "$counter" ]; then
    read -r failures <"$counter" 2>/dev/null
fi
case $failures in
'' | *[!0-9]*) failures=0 ;;
esac

write_count_to() {
    # temp file and rename: a cut never leaves half a number
    printf '%s\n' "$2" >"$1.tmp" 2>/dev/null && mv -f "$1.tmp" "$1" 2>/dev/null
}

write_count() {
    write_count_to "$counter" "$1"
}

if [ "$failures" -ge 3 ]; then
    tries_file=$dir/giveup-tries
    tries=0
    if [ -r "$tries_file" ]; then
        read -r tries <"$tries_file" 2>/dev/null
    fi
    case $tries in
    '' | *[!0-9]*) tries=0 ;;
    esac
    if [ "$tries" -ge 10 ]; then
        # Stop plasmalogin respawning this session; a reboot takes the boot
        # fallback.
        logger -t atlas-wizard-session "GiveUp failed 10 times; waiting for a reboot (text-mode fallback)" 2>/dev/null
        sleep infinity
    fi
    write_count_to "$tries_file" $((tries + 1))
    err=$(busctl --system call net.eterneon.atlas.WizardHelper \
        /net/eterneon/atlas/WizardHelper net.eterneon.atlas.WizardHelper1 GiveUp 2>&1)
    rc=$?
    if [ "$rc" -eq 0 ]; then
        exit 0
    fi
    case $err in
    # busctl prints the error's message, "setup-done: ...", not its name
    *setup-done:*)
        # Setup finished meanwhile: EndSetup reruns the clean-up and restarts
        # the display manager.
        if busctl --system call net.eterneon.atlas.WizardHelper \
            /net/eterneon/atlas/WizardHelper net.eterneon.atlas.WizardHelper1 EndSetup \
            >/dev/null 2>&1; then
            exit 0
        fi
        err="EndSetup failed after SetupDone: $err"
        ;;
    esac
    logger -t atlas-wizard-session "GiveUp failed (busctl exit $rc): $err" 2>/dev/null
    # Wait before failing, so a restart loop cannot spin: 5 s after the first
    # failure, 15 s after the second, then 30 s (about 5 minutes in all).
    case $tries in
    0) sleep 5 ;;
    1) sleep 15 ;;
    *) sleep 30 ;;
    esac
    exit 1
fi

# Counted before the start; reset below when the wizard exits cleanly.
write_count $((failures + 1))

XDG_SESSION_TYPE=wayland
XDG_CURRENT_DESKTOP=KDE
KDE_SESSION_VERSION=6
QT_QPA_PLATFORM=wayland
KWIN_USE_OVERLAYS=0
export XDG_SESSION_TYPE XDG_CURRENT_DESKTOP KDE_SESSION_VERSION QT_QPA_PLATFORM KWIN_USE_OVERLAYS
# Qt starts the accessibility bus (at-spi-bus-launcher) on demand when Orca
# or the wizard's screen reader switch asks for it, so
# QT_LINUX_ACCESSIBILITY_ALWAYS_ON is not set: it would start the bus on every
# setup for nothing.

# Not `exec`: the script must see how KWin ended to reset the counter.
# The flags are the ones plasmalogin's own greeter session uses
# (plasma-login-kwin_wayland.service), plus --exit-with-session so the session
# ends when the wizard does.
/usr/bin/kwin_wayland --no-lockscreen --no-global-shortcuts --no-kactivities \
    --inputmethod plasma-keyboard --locale1 \
    --exit-with-session /usr/bin/atlas-wizard &
pid=$!
# logind ends the session with SIGTERM or SIGHUP: pass it on.
trap 'kill -TERM "$pid" 2>/dev/null' TERM HUP INT
wait "$pid"
status=$?
# The trap interrupts the first wait; wait again for the real status.
if kill -0 "$pid" 2>/dev/null; then
    wait "$pid"
    status=$?
fi
if [ "$status" -eq 0 ]; then
    write_count 0
fi
exit "$status"
