#!/bin/sh
# The setup session (plasmalogin autologin, telamon-wizard.desktop): KWin alone
# with the wizard as its only client. Counts the starts of this boot that did
# not end with setup done; at 3 it asks the helper to give up (the text-mode
# fallback takes over). If that fails it logs, waits and exits non-zero; on
# SetupDone it calls EndSetup. After 10 failed GiveUp calls it asks logind to
# reboot: the boot count then reaches the boot fallback row.

dir=/run/telamon-setup
counter=$dir/session-failures
tries_file=$dir/giveup-tries
log() {
    logger -t telamon-wizard-session "$1" 2>/dev/null
}

# A count from a file, digits only; anything else is 0, and more than four
# digits (written by hand) counts as "many".
read_count() {
    n=0
    if [ -r "$1" ]; then
        read -r n <"$1" 2>/dev/null
    fi
    case $n in
    '' | *[!0-9]*) n=0 ;;
    ?????*) n=9999 ;;
    esac
    echo "$n"
}

write_count() {
    # temp file and rename: a cut never leaves half a number
    printf '%s\n' "$2" 2>/dev/null >"$1.tmp" && mv -f "$1.tmp" "$1" 2>/dev/null
}

give_up() {
    tries=$(read_count "$tries_file")
    if [ "$tries" -ge 10 ]; then
        log "GiveUp failed 10 times; rebooting (the boot count leads to the text-mode fallback)"
        systemctl reboot >/dev/null 2>&1 ||
            log "the reboot was refused; waiting for one (text-mode fallback after it)"
        # Stop plasmalogin respawning this session either way.
        sleep infinity
    fi
    write_count "$tries_file" $((tries + 1)) ||
        log "cannot write $tries_file"
    err=$(busctl --system call net.eterneon.telamon.WizardHelper \
        /net/eterneon/telamon/WizardHelper net.eterneon.telamon.WizardHelper1 GiveUp 2>&1)
    rc=$?
    if [ "$rc" -eq 0 ]; then
        exit 0
    fi
    case $err in
    # busctl prints the error's message, "setup-done: ...", not its name
    *setup-done:*)
        # Setup finished meanwhile: EndSetup reruns the clean-up and restarts
        # the display manager.
        if busctl --system call net.eterneon.telamon.WizardHelper \
            /net/eterneon/telamon/WizardHelper net.eterneon.telamon.WizardHelper1 EndSetup \
            >/dev/null 2>&1; then
            exit 0
        fi
        err="EndSetup failed after SetupDone: $err"
        ;;
    esac
    log "GiveUp failed (busctl exit $rc): $err"
    # Wait before failing, so a restart loop cannot spin: 5 s after the first
    # failure, 15 s after the second, then 30 s (about 5 minutes in all).
    case $tries in
    0) sleep 5 ;;
    1) sleep 15 ;;
    *) sleep 30 ;;
    esac
    exit 1
}

failures=$(read_count "$counter")
if [ "$failures" -ge 3 ]; then
    give_up
fi

# Counted before the start, and reset only when setup is done: a wizard that
# exits 0 without finishing is a failed start too. A count that cannot be
# written would never reach 3, so that start gives up at once.
if ! write_count "$counter" $((failures + 1)); then
    log "cannot write $counter; giving up on the graphical setup"
    give_up
fi

XDG_SESSION_TYPE=wayland
XDG_CURRENT_DESKTOP=KDE
KDE_SESSION_VERSION=6
QT_QPA_PLATFORM=wayland
KWIN_USE_OVERLAYS=0
export XDG_SESSION_TYPE XDG_CURRENT_DESKTOP KDE_SESSION_VERSION QT_QPA_PLATFORM KWIN_USE_OVERLAYS
# Qt starts the accessibility bus (at-spi-bus-launcher) on demand when Orca
# or the wizard's screen reader switch asks for it, so
# QT_LINUX_ACCESSIBILITY_ALWAYS_ON is not set: it would start the bus on every
# setup for nothing.

# Not `exec`: the script must see how KWin ended to reset the counter.
# The flags are the ones plasmalogin's own greeter session uses
# (plasma-login-kwin_wayland.service), plus --exit-with-session so the session
# ends when the wizard does.
/usr/bin/kwin_wayland --no-lockscreen --no-global-shortcuts --no-kactivities \
    --inputmethod plasma-keyboard --locale1 \
    --exit-with-session /usr/bin/telamon-wizard &
pid=$!
# logind ends the session with SIGTERM or SIGHUP: pass it on.
trap 'kill -TERM "$pid" 2>/dev/null' TERM HUP INT
wait "$pid"
status=$?
# The trap interrupts the first wait; wait again for the real status.
if kill -0 "$pid" 2>/dev/null; then
    wait "$pid"
    status=$?
fi
if [ -e /etc/telamon/setup-done ] || [ -e /etc/atlasos/setup-done ] || [ -e /etc/plasma-setup-done ]; then
    write_count "$counter" 0
else
    # plasmalogin relogs at once (Relogin=true): never faster than this
    sleep 2
fi
exit "$status"
