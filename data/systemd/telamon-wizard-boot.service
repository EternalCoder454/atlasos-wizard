[Unit]
Description=Telamon Setup: decide at boot whether setup is needed
Documentation=https://github.com/EternalCoder454/atlasos-wizard/blob/main/docs/DESIGN.md
# Before the login screen, so the setup autologin (or its removal) is in place
# when plasmalogin starts.
Before=display-manager.service plasmalogin.service
After=systemd-sysusers.service systemd-tmpfiles-setup.service systemd-user-sessions.service
# Not on the live ISO, which has no first-run setup.
ConditionKernelCommandLine=!rd.live.image

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/telamon-wizard-boot prepare
# Every external command it runs has its own 20 s limit; this is the backstop,
# above the worst case of one boot (four commands at 20 s and the 5 s wait for
# logind), so a slow command is never killed halfway by systemd.
TimeoutStartSec=150
# /var/lib/telamon-wizard, created 0755 and writable.
StateDirectory=telamon-wizard
StateDirectoryMode=0755
UMask=0022

# It must write /etc (the setup autologin, the done markers, passwd and shadow
# through chage and usermod), /var/lib/telamon-wizard and /run/telamon-setup, and
# talk to systemd and logind over their sockets. /var/lib/atlas-wizard is for
# moving Atlas Wizard's state file out of it, once. Nothing else.
ProtectSystem=strict
ReadWritePaths=/etc -/run/telamon-setup -/var/lib/atlas-wizard
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
# No writable and executable memory: the program and the shadow-utils tools
# it runs are plain C and Rust, no JIT.
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# The journal, the system bus and systemd's sockets; shadow-utils' audit
# record needs AF_NETLINK and they go on without it.
RestrictAddressFamilies=AF_UNIX
# The password must never land in a core file (the program also turns
# dumping off).
LimitCORE=0
ProtectProc=invisible
# Left out on purpose: NoNewPrivileges. chage and usermod run in their own
# SELinux domains, and it blocks the transition (as in
# telamon-wizard-helper.service). To verify in the Telamon OS VM with SELinux
# enforcing (`ausearch -m avc`, the journal for EPERM; MemoryDenyWriteExecute
# and the address families too), then add a CapabilityBoundingSet of what the
# run shows it needs (likely CAP_CHOWN CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH
# CAP_FOWNER CAP_FSETID CAP_KILL CAP_SETUID CAP_SETGID CAP_AUDIT_WRITE),
# SystemCallFilter=@system-service and, for the fallback, PrivateDevices=yes
# or a DeviceAllow= list. Not before: a wrong guess kills the one way left
# to make an account.

[Install]
WantedBy=multi-user.target
