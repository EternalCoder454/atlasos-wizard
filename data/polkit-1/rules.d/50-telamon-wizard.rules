// Telamon Wizard: the setup user, and only it, in its own active local session
// (the plasmalogin autologin session "telamon-wizard"), may do what setup needs:
// our helper's three actions, and the stock actions the pages use to apply
// choices at once. Nothing else is granted, and every action's default stays
// "no".
//
// After setup the user telamon-setup is locked (account expired, no shell) and
// the setup autologin is removed, so it can have no session and this rule can
// never match again. As a second lock, once a done marker exists
// (/etc/telamon/setup-done, Atlas Wizard's /etc/atlasos/setup-done or
// /etc/plasma-setup-done) the answer is NO, and
// it is NO whenever the markers cannot be checked: the grants end with setup
// even if the clean-up failed. The one exception is the helper's "finish"
// action: Finish writes the markers first and EndSetup (same action) comes
// after them, so that action alone stays open; the helper itself refuses
// anything but the end of a finished setup then (state "finish" = "done").
var telamonWizardMarkers = [
    ["/etc/telamon", "/etc/telamon/setup-done"],
    ["/etc/atlasos", "/etc/atlasos/setup-done"],
    ["/etc", "/etc/plasma-setup-done"]
];

// True only when polkit.spawn confirms that no marker exists. The test also
// needs the marker's parent directory to exist and be searchable ("-d", "-x"):
// a plain `! -e` is true when stat fails (EACCES), which would read as "no
// marker". This only proves the parent can be searched: a stat failure on the
// marker file itself still reads as "no marker", and the helper's fail-closed
// is_done_or_unknown is the backstop for that.
// (tmpfiles.d creates /etc/telamon and /etc/atlasos.) spawn throws on a non-zero exit (a marker
// exists, or the parent is missing) and when it cannot run: all are "no".
function telamonWizardSetupOpen() {
    for (var i = 0; i < telamonWizardMarkers.length; i++) {
        try {
            polkit.spawn(["/usr/bin/test", "-d", telamonWizardMarkers[i][0],
                          "-a", "-x", telamonWizardMarkers[i][0],
                          "-a", "!", "-e", telamonWizardMarkers[i][1]]);
        } catch (e) {
            return false;
        }
    }
    return true;
}

polkit.addRule(function(action, subject) {
    var granted = [
        // the helper (net.eterneon.telamon.WizardHelper)
        "net.eterneon.telamon.wizard.create-account",
        "net.eterneon.telamon.wizard.finish",
        "net.eterneon.telamon.wizard.fallback",
        // language and keyboard (localed)
        "org.freedesktop.locale1.set-locale",
        "org.freedesktop.locale1.set-keyboard",
        // time zone (timedated); the clock's NTP switch is not used, so not granted
        "org.freedesktop.timedate1.set-timezone",
        // host name (hostnamed)
        "org.freedesktop.hostname1.set-static-hostname",
        "org.freedesktop.hostname1.set-hostname",
        // Wi-Fi (NetworkManager)
        "org.freedesktop.NetworkManager.settings.modify.system",
        "org.freedesktop.NetworkManager.network-control"
    ];
    if (granted.indexOf(action.id) >= 0 &&
        subject.user == "telamon-setup" && subject.local && subject.active) {
        if (action.id == "net.eterneon.telamon.wizard.finish" || telamonWizardSetupOpen()) {
            return polkit.Result.YES;
        }
        return polkit.Result.NO;
    }
});
