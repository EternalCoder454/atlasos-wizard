# The build and test image of Telamon Wizard: CI runs in it
# (ghcr.io/eternalcoder454/telamon-wizard-dev, the `ci` target) and
# scripts/dev.sh builds the same file locally (the `dev` target). Every package
# the build, the tests and the lint need is listed here and nowhere else.
#
#   podman build -f ci/Containerfile --target ci \
#       --build-arg TELAMON_FRAMEWORK_REF=<tag> -t <name> .
#
# Build context: the repo root (only packaging/telamon-wizard.spec is read).
# TELAMON_FRAMEWORK_REF is the tag in Cargo.toml (ci/framework-ref.sh prints it).
# TELAMON_FRAMEWORK_SHA is the commit Cargo.lock locks it to (ci/framework-sha.sh
# prints it): the clone must be at that commit, because a tag can be moved. It
# is empty only when a build uses another ref than the pinned one (dev.sh).
# telamon-ui, which the app builds against, is in no repository: the first stage
# builds atlas-framework's RPMs from that tag.

ARG FEDORA=registry.fedoraproject.org/fedora:44

FROM ${FEDORA} AS framework
ARG TELAMON_FRAMEWORK_REF
ARG TELAMON_FRAMEWORK_SHA=
RUN test -n "$TELAMON_FRAMEWORK_REF" || { echo "set --build-arg TELAMON_FRAMEWORK_REF=<tag>" >&2; exit 1; }
RUN --mount=type=cache,target=/var/cache/libdnf5,sharing=locked \
    dnf -y --setopt=keepcache=1 install git-core tar gzip rpm-build dnf5-plugins
# A tag or a branch, not a bare commit; build-rpm.sh packages HEAD.
RUN git clone --quiet --depth 1 --branch "$TELAMON_FRAMEWORK_REF" \
        https://github.com/EternalCoder454/atlas-framework /framework
RUN [ -z "$TELAMON_FRAMEWORK_SHA" ] || [ "$(git -C /framework rev-parse HEAD)" = "$TELAMON_FRAMEWORK_SHA" ] || \
    { echo "atlas-framework $TELAMON_FRAMEWORK_REF is not at $TELAMON_FRAMEWORK_SHA (Cargo.lock): the tag moved" >&2; exit 1; }
RUN --mount=type=cache,target=/var/cache/libdnf5,sharing=locked \
    /framework/packaging/build-rpm.sh /out
RUN rm -rf /framework/.git

FROM ${FEDORA} AS ci
LABEL org.opencontainers.image.source=https://github.com/EternalCoder454/atlasos-wizard \
      org.opencontainers.image.description="Telamon Wizard build and test image" \
      org.opencontainers.image.licenses=MIT
COPY --from=framework /out/ /telamon-rpms/
COPY packaging/telamon-wizard.spec /tmp/telamon-wizard.spec
# Tools beyond the spec's BuildRequires:
#   mold, ccache         faster linking and C++ compiles
#   clippy, rustfmt      lint
#   ShellCheck           lint of scripts/ and data/libexec/
#   dbus-daemon, python3-dbusmock, accountsservice, polkit   helper bus tests
#   shadow-utils, passwd, util-linux, systemd                boot and helper tests
#   cracklib-dicts       password strength tests (libpwquality's dictionary)
#   Xvfb, qt6-qtbase-gui, kf6-qqc2-desktop-style             headless smoke run
#   zstd, tar, git-core  actions/cache and actions/checkout
RUN --mount=type=cache,target=/var/cache/libdnf5,sharing=locked \
    dnf -y --setopt=keepcache=1 install dnf5-plugins rpm-build git-core tar gzip zstd findutils \
        clippy rustfmt mold ccache ShellCheck desktop-file-utils \
        dbus-daemon python3-dbusmock accountsservice polkit \
        shadow-utils passwd util-linux systemd \
        libxcrypt-devel libpwquality-devel cracklib-dicts \
        xorg-x11-server-Xvfb qt6-qtbase-gui kf6-qqc2-desktop-style \
        qt6-qtdeclarative-devel \
        /telamon-rpms/telamon-ui-[0-9]*.rpm /telamon-rpms/telamon-symbols-fonts-[0-9]*.rpm && \
    dnf -y --setopt=keepcache=1 builddep /tmp/telamon-wizard.spec && \
    rm -rf /telamon-rpms /tmp/telamon-wizard.spec
# atlas-framework's source, for its lint tools (tools/lint-app.sh,
# tools/check-app-names.sh read ui/ too), at the same tag as telamon-ui.
COPY --from=framework /framework /opt/telamon-framework
ENV TELAMON_FRAMEWORK=/opt/telamon-framework
# dev-image.yml compares this with ci/image-tag.sh to see whether the published
# image is out of date.
ARG IMAGE_TAG=
LABEL net.eterneon.telamon.wizard.image-tag=$IMAGE_TAG

# The local image (scripts/dev.sh): the ci image plus what headless GUI runs
# and screenshots need.
FROM ci AS dev
RUN --mount=type=cache,target=/var/cache/libdnf5,sharing=locked \
    dnf -y --setopt=keepcache=1 install breeze-icon-theme ImageMagick xdotool \
        kwin plasma-workspace orca at-spi2-core
